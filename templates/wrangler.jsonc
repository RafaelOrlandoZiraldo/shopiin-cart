{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-cart",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopping-cart-dev",
      "database_id": "REPLACE_ME"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "shopping-cart-products-dev"
    }
  ]
}
